{
  "name": "milo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "services/ai-gateway"
  ],
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "server": "node server/acp-bridge.mjs",
    "dev:all": "concurrently -k -n web,acp \"npm -w apps/web run dev\" \"node server/acp-bridge.mjs\"",
    "gateway": "npm -w services/ai-gateway run dev",
    "test": "npm -w apps/web test",
    "test:gateway": "npm -w services/ai-gateway test",
    "build": "npm -w apps/web run build",
    "lint": "oxlint",
    "preview": "npm -w apps/web run preview"
  },
  "dependencies": {
    "@zed-industries/agent-client-protocol": "^0.4.5",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@zed-industries/codex-acp": "^0.16.0",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
