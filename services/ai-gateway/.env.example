# MILO AI Gateway · local config template
#
# Copy this file to `.env` and fill in your real values. `.env` is git-ignored.
# DO NOT commit a real `MINIMAX_API_KEY` to the repo.

# Required. The MiniMax API key for the deployed gateway.
# Get it from the MiniMax platform console (https://api.minimax.chat).
MINIMAX_API_KEY=

# Optional overrides. Defaults match the production vendor.
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# Port the Express server listens on. Vercel / Fly / Railway override this.
PORT=8787

# Per-IP rate limit (requests per minute). Default 60.
RATE_LIMIT_PER_MINUTE=60

# Request timeout for upstream MiniMax calls, milliseconds.
MINIMAX_TIMEOUT_MS=15000